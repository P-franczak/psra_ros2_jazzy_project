<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rally_track">
    <static>true</static>
    <link name="track_link">
      <!-- White edge lines -->
      <visual name="edge_lines">
          <geometry><mesh><uri>meshes/edge_lines.stl</uri></mesh></geometry>

          <material>
              <ambient>1 1 1 1</ambient>
              <diffuse>1 1 1 1</diffuse>
          </material>
      </visual>

      <!-- Start line - white squares -->
      <visual name="start_white">
          <geometry><mesh><uri>meshes/start_white.stl</uri></mesh></geometry>

          <material>
              <ambient>1 1 1 1</ambient>
              <diffuse>1 1 1 1</diffuse>
          </material>
      </visual>

      <!-- Start line - black squares -->
      <visual name="start_black">
          <geometry><mesh><uri>meshes/start_black.stl</uri></mesh></geometry>

          <material>
              <ambient>0.01 0.01 0.01 1</ambient>
              <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
      </visual>

      <!-- Red barriers -->
      <visual name="barriers_red">
          <geometry>
              <mesh>
                  <uri>meshes/barriers_red.stl</uri>
              </mesh>
          </geometry>

          <material>
              <ambient>0.7 0.02 0.02 1</ambient>
              <diffuse>0.9 0.03 0.03 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
      </visual>

      <!-- White barriers -->
      <visual name="barriers_white">
        <geometry><mesh><uri>meshes/barriers_white.stl</uri></mesh></geometry>
        <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>


      <collision name="road_collision">
        <geometry><mesh><uri>meshes/road.stl</uri></mesh></geometry>
      </collision>
      <visual name="road_visual">
        <geometry><mesh><uri>meshes/road.stl</uri></mesh></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <collision name="barriers_collision">
        <geometry><mesh><uri>meshes/barriers.stl</uri></mesh></geometry>
      </collision>
