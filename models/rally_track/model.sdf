<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rally_track">
    <static>true</static>
    <link name="track_link">
      <collision name="road_collision">
        <geometry><mesh><uri>meshes/road.stl</uri></mesh></geometry>
      </collision>
      <visual name="road_visual">
        <geometry><mesh><uri>meshes/road.stl</uri></mesh></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <collision name="barriers_collision">
        <geometry><mesh><uri>meshes/barriers.stl</uri></mesh></geometry>
      </collision>
      <visual name="barriers_visual">
        <geometry><mesh><uri>meshes/barriers.stl</uri></mesh></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>

      <!-- Visual-only markings: they do not affect vehicle collision. -->
      <visual name="centerline_visual">
        <geometry><mesh><uri>meshes/centerline.stl</uri></mesh></geometry>
        <material>
          <ambient>1 0.85 0.05 1</ambient>
          <diffuse>1 0.85 0.05 1</diffuse>
          <emissive>0.12 0.08 0 1</emissive>
        </material>
      </visual>
      <visual name="start_line_visual">
        <geometry><mesh><uri>meshes/start_line.stl</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
